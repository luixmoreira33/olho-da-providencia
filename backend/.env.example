# Copie para .env e preencha as variáveis que você tem

# ===== Auth (local) =====
# JWT_SECRET=change-me-to-a-long-random-string
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme

# ===== OKD (OpenShift) =====
OKD_KUBECONFIG=/path/to/okd-kubeconfig
OKD_CONTEXT=okd-prod
OKD_NAMESPACE=production
OKD_APP_LABEL=app

# ===== EKS =====
EKS_KUBECONFIG=/path/to/eks-kubeconfig
EKS_CONTEXT=eks-prod
EKS_NAMESPACE=production
EKS_APP_LABEL=app

# ===== ELK / Elasticsearch =====
ELK_URL=https://elasticsearch.example.com:9200
ELK_API_KEY=your_api_key_here
ELK_INDEX_PATTERN=logs-*
ELK_SERVICE_FIELD=service.name
ELK_TIME_RANGE=now-1h

# ===== Dynatrace =====
DYNATRACE_URL=https://abc12345.live.dynatrace.com
DYNATRACE_TOKEN=dt0c01.xxxxxxxx.yyyyyyyyyyyy

# ===== AI Insight (opcional) =====
AI_ENABLED=true
AI_BASE_URL=https://api.x.ai/v1
AI_API_KEY=xai-...
AI_MODEL=grok-beta

# ===== AWS (EC2 + ECS) =====
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===== Collector / Cache =====
COLLECTOR_INTERVAL_SECONDS=60

# ===== Admin: recursos visíveis (vazio = todos) =====
# VISIBLE_RESOURCES=payment-service,my-ec2-instance,cluster/my-service

# ===== Deep Links =====
KIBANA_URL=https://kibana.example.com
DYNATRACE_UI_URL=https://xxx.live.dynatrace.com
OKD_CONSOLE_URL=https://console.okd.example.com
EKS_CONSOLE_URL=https://console.eks.example.com

# ===== Alerts (v1.1) =====
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ===== OIDC =====
# OIDC_ENABLED=false
# OIDC_ISSUER=https://keycloak.example.com/realms/olho
# OIDC_CLIENT_ID=olho-da-providencia

